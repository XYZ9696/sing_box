        "tag": "dns_proxy",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🚀 节点选择"
      }
    ],
    "rules": [
      { "clash_mode": "Direct", "server": "dns_direct" },
      { "clash_mode": "Global", "server": "dns_proxy" },
      { "rule_set": "geosite-cn", "server": "dns_direct" },
      { "rule_set": "geosite-private", "server": "dns_direct" },
      { "rule_set": "geosite-geolocation-!cn", "server": "dns_proxy" }
    ],
    "final": "dns_proxy",
    "strategy": "ipv4_only"
  },


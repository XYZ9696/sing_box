    },

    { "tag": "🐸 手动切换", "type": "selector", "outbounds": ["{all}"] },

    {
      "tag": "🇭🇰 香港节点",
      "type": "selector",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["🇭🇰|HK|hk|香港|港|HongKong|HK 香港"] }]
    },
    {
      "tag": "🇸🇬 新加坡节点",
      "type": "selector",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["🇸🇬|SG|sg|新加坡|狮城|Singapore|SG Singapore"] }]
    },
    {
      "tag": "🇯🇵 日本节点",
      "type": "selector",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["🇯🇵|JP|jp|日本|日|Japan|JP Japan"] }]
    },
    {
      "tag": "🇹🇼 台湾节点",
      "type": "selector",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["🇹🇼|TW|tw|台湾|台|Taiwan|TW CN Taiwan"] }]
    },
    {
      "tag": "🇰🇷 韩国节点",
      "type": "selector",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["🇰🇷|KR|kr|韩国|韩|Korea|KR South Korea"] }]
    },
    {
      "tag": "🇺🇲 美国节点",
      "type": "selector",
      "outbounds": ["{all}"],
      "filter": [
        { "action": "include", "keywords": ["🇺🇸|US|us|美国|美|United States|US United States|US United"] },
        { "action": "exclude", "keywords": ["香港|港|HK|hk|HongKong|新加坡|SG|sg|Japan|JP|jp|台湾|TW|tw|Korea|KR|kr"] }
      ]
    },

    {
      "tag": "🔯 香港自动",
      "type": "urltest",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["🇭🇰|HK|hk|香港|港|HongKong|HK 香港"] }],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {
      "tag": "🇸🇬 新加坡自动",
      "type": "urltest",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["🇸🇬|SG|sg|新加坡|狮城|Singapore|SG Singapore"] }],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },
    {
      "tag": "♻️ 自动选择",
      "type": "urltest",
      "outbounds": ["{all}"],
      "filter": [{ "action": "exclude", "keywords": ["网站|地址|剩余|过期|时间|有效|Traffic|Expire|流量|到期|Reset|Days|GB |"] }],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50
    },

    { "tag": "GLOBAL", "type": "selector", "outbounds": ["{all}"] },
    { "tag": "🎯 全球直连", "type": "direct" }

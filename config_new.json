{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },

  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9095",
      "external_ui": "/etc/sing-box/ui",
      "secret": "",
      "external_ui_download_url": "https://ghfast.top/https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "🎯 全球直连",
      "default_mode": "rule"
    }
  },

  "dns": {
    "servers": [
      {
        "tag": "dns_direct",
        "type": "udp",
        "server": "223.5.5.5",
        "detour": "🎯 全球直连"
      },
      {
        "tag": "dns_proxy",
        "type": "https",
        "server": "https://8.8.8.8/dns-query",
        "detour": "🚀 节点选择"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-cn",
        "server": "dns_direct"
      },
      {
        "rule_set": "geosite-private",
        "server": "dns_direct"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "server": "dns_proxy"
      }
    ],
    "final": "dns_proxy",
    "strategy": "ipv4_only"
  },

  "inbounds": [
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "0.0.0.0",
      "listen_port": 7895
    }
  ],

  "outbounds": [
    { "tag": "🚀 节点选择", "type": "selector", "outbounds": ["{all}"] },

    { "tag": "♻ 自动选择", "type": "urltest", "outbounds": ["{all}"], "url": "http://www.gstatic.com/generate_204", "interval": "10m" },

    { "tag": "🎥 Netflix", "type": "selector", "outbounds": ["🚀 节点选择", "♻ 自动选择", "🎯 全球直连"] },

    { "tag": "🤖 OpenAI", "type": "selector", "outbounds": ["🚀 节点选择"] },

    { "tag": "📹 YouTube", "type": "selector", "outbounds": ["🚀 节点选择", "🎯 全球直连"] },

    { "tag": "🍀 Google", "type": "selector", "outbounds": ["🚀 节点选择"] },

    { "tag": "👨‍💻 Github", "type": "selector", "outbounds": ["🚀 节点选择", "🎯 全球直连"] },

    { "tag": "📲 Telegram", "type": "selector", "outbounds": ["🚀 节点选择"] },

    { "tag": "🪟 Microsoft", "type": "selector", "outbounds": ["🚀 节点选择", "🎯 全球直连"] },

    { "tag": "🎵 TikTok", "type": "selector", "outbounds": ["🚀 节点选择"] },

    { "tag": "🍏 Apple", "type": "selector", "outbounds": ["🎯 全球直连"] },

    { "tag": "🐠 漏网之鱼", "type": "selector", "outbounds": ["🚀 节点选择", "🎯 全球直连"] },

    { "tag": "🐸 手动切换", "type": "selector", "outbounds": ["{all}"] },

    {
      "tag": "🇭🇰 香港节点",
      "type": "selector",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["HK", "香港", "HongKong"] }]
    },

    {
      "tag": "🇯🇵 日本节点",
      "type": "selector",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["JP", "日本", "Japan"] }]
    },

    {
      "tag": "🇺🇸 美国节点",
      "type": "selector",
      "outbounds": ["{all}"],
      "filter": [{ "action": "include", "keywords": ["US", "美国", "United States"] }]
    },

    { "tag": "🎯 全球直连", "type": "direct" }
  ],

  "route": {
    "auto_detect_interface": true,
    "final": "🐠 漏网之鱼",
    "default_mark": 666,

    "rules": [
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },

      { "rule_set": "geosite-private", "outbound": "🎯 全球直连" },
      { "rule_set": "geosite-cn", "outbound": "🎯 全球直连" },

      { "rule_set": "geosite-chat", "outbound": "🤖 OpenAI" },
      { "rule_set": "geosite-youtube", "outbound": "📹 YouTube" },
      { "rule_set": "geosite-github", "outbound": "👨‍💻 Github" },
      { "rule_set": "geosite-google", "outbound": "🍀 Google" },
      { "rule_set": "geosite-telegram", "outbound": "📲 Telegram" },
      { "rule_set": "geosite-tiktok", "outbound": "🎵 TikTok" },
      { "rule_set": "geosite-netflix", "outbound": "🎥 Netflix" },
      { "rule_set": "geosite-apple", "outbound": "🍏 Apple" },
      { "rule_set": "geosite-microsoft", "outbound": "🪟 Microsoft" },

      { "rule_set": "geosite-geolocation-!cn", "outbound": "🚀 节点选择" }
    ],

    "rule_set": [
      {
        "tag": "geosite-chat",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ai-chat-!cn.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/youtube.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/google.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-github",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/github.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/telegram.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-netflix",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/netflix.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-apple",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/apple.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-microsoft",
        "type": "remote",
        "format": "binary",
        "url": "https://ghfast.top/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/microsoft.srs",
        "download_detour": "🎯 全球直连"
      }
    ]
  }
}